cat > .gitignore <<'EOF'
# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example

# Logs
*.log
logs/

# Editor and operating system files
.DS_Store
.vscode/
.idea/
EOF